# auto-work 部署配置 —— 部署在容器 /home/auto-work;dsh 持久件仍在 /sgl
#
# 约定:
#   AUTO_WORK  = auto-work 代码根,默认 /home/auto-work
#   DSH_HOME   = dsh 配置/技能根,默认 /sgl/.dsh-home(持久)
#   DSH_ENV_FILE = dsh 环境文件,默认 /sgl/dsh-env.sh
#
# 优先级(高→低):调用时的环境变量 > 本文件 > 脚本内置默认
# 例: export AUTO_WORK=/custom/auto-work          # 换 auto-work 位置
#     export RUNS_DIR=/home/runs                  # 换运行时数据根(默认 /home/runs)
#     export DSH_HOME=/sgl/.dsh-home              # 换 dsh 配置根(技能也在其下)

AUTO_WORK="${AUTO_WORK:-/home/auto-work}"
DSH_HOME="${DSH_HOME:-/sgl/.dsh-home}"
DSH_ENV_FILE="${DSH_ENV_FILE:-/sgl/dsh-env.sh}"

# auto-work 子目录(一般无需改,随 AUTO_WORK 走)
STEPS_DIR="${STEPS_DIR:-${AUTO_WORK}/steps}"
TASKS_DIR="${TASKS_DIR:-${AUTO_WORK}/tasks}"
SCRIPTS_DIR="${SCRIPTS_DIR:-${AUTO_WORK}/scripts}"
LIB_DIR="${LIB_DIR:-${AUTO_WORK}/lib}"

# 运行时数据根(独立于代码根,不再分 work/runs 两个目录):
# 每轮请求 = ${RUNS_DIR}/<时间戳> 一个目录,server_command.sh 与 step 结果都在其中。
RUNS_DIR="${RUNS_DIR:-/home/runs}"

# 关键文件
PARSER="${PARSER:-${LIB_DIR}/server_command_parser.py}"
STEP_START_SERVER="${STEP_START_SERVER:-${STEPS_DIR}/start-server.sh}"

# 技能安装目录(拷贝 skill bundle 的目标)
SKILLS_INSTALL_DIR="${SKILLS_INSTALL_DIR:-${DSH_HOME}/skills}"
